{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.wpbrigade.proposalai",
  "developer": {
    "name": "WPBrigade",
    "websiteUrl": "https://your-domain.com",
    "privacyUrl": "https://your-domain.com/privacy",
    "termsOfUseUrl": "https://your-domain.com/terms"
  },
  "name": {
    "short": "Proposal AI",
    "full": "Business Proposal AI Assistant"
  },
  "description": {
    "short": "Generate AI-powered business proposals from your historical repository.",
    "full": "An AI assistant that analyses your business proposal requirements, searches your historical proposal repository for relevant examples, asks targeted clarification questions, and generates complete professional proposals with review annotations."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "{{TEAMS_APP_ID}}",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            {
              "title": "new",
              "description": "Start a new business proposal"
            },
            {
              "title": "help",
              "description": "Show usage instructions"
            },
            {
              "title": "skip",
              "description": "Skip the current clarification question"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["your-domain.com"]
}
